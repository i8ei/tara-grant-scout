{
  "name": "tara-grant-scout",
  "compatibility_date": "2025-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tara-grant-scout-db",
      "database_id": "c8ba9253-bbc0-43fc-a8f3-abf9437c2881",
      "migrations_dir": "./migrations"
    }
  ],
  // Workers AI — 補助金のAI解析（主モデル: Qwen3 30B）。外部APIはフォールバック
  "ai": {
    "binding": "AI"
  },
  // Cron Triggers — 毎日21:00 UTC (= JST 06:00) に補助金一覧取得
  "triggers": {
    "crons": ["0 21 * * *"]
  },
  // Queue — 詳細取得・AI解析ジョブ
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "tara-grant-scout-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "tara-grant-scout-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "CORS_ORIGIN": "http://localhost:5173",
    "APP_BASE_URL": "http://localhost:5173"
  },
  // Static assets (React SPA)
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
